{
  "name": "@pocketsign/klon-sdk",
  "version": "0.0.0",
  "description": "KLON SDK",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pocketsign/klon-sdk-typescript.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "typecheck": "tsgo --noEmit -p .",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck",
    "fix": "pnpm run lint:fix && pnpm run format:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "oauth4webapi": "^3.8.6",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsdown": "^0.22.1",
    "typedoc": "^0.28.19",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "oauth4webapi": "^3.0.0"
  },
  "packageManager": "pnpm@11.5.1"
}
