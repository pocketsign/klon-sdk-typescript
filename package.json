{
  "name": "@pocketsign/klon-sdk-typescript",
  "version": "0.1.0",
  "description": "KLON SDK",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/pocketsign/klon.git",
    "directory": "sdk/typescript"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "typecheck": "tsgo --noEmit -p .",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck",
    "fix": "pnpm run lint:fix && pnpm run format:fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260318.1",
    "oauth4webapi": "^3.8.5",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.21.0",
    "tsdown": "^0.21.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "oauth4webapi": "^3.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
